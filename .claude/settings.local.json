{
  "permissions": {
    "allow": [
      "Bash(git init:*)",
      "Bash(~/.bun/bin/bun run:*)",
      "Bash(git checkout:*)",
      "Bash(export PATH=\"$HOME/.bun/bin:$PATH\")",
      "Bash(bun run build)",
      "Bash(git -C /home/maciejka/projects/ai-sandbox/100pushups status --short)",
      "Bash(git -C /home/maciejka/projects/ai-sandbox/100pushups log --oneline -5)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
